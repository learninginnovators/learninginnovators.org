---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <section>
    <div class="px-8 py-12 mx-auto md:px-12 lg:px-32 max-w-7xl lg:pb-24">
      <div class="max-w-3xl mx-auto">
        <h1
          class="text-5xl font-semibold text-center font-display text-blue-950 sm:text-6xl text-balance"
        >
          What is MATTER?
        </h1>

        <div class="mt-10 space-y-6 text-left text-lg leading-relaxed text-slate-600">
          <p>
            MATTER stands for Mastery through Active Tasks, Trusted Evidence, and Reflective Responses. MATTER is a student-centred pedagogy built
            around the concepts of assessment as learning, iterative formative
            feedback loops, and mastery learning. It gives students agency in
            their learning while guaranteeing educational standards.
          </p>

          <div>
            <p>MATTER draws on:</p>

            <ul class="mt-3 space-y-3 list-disc list-outside pl-6">
              <li>
                <strong class="font-semibold text-blue-950">
                  Outcome-based learning,
                </strong>
                where tasks are explicitly aligned with clear learning
                objectives and grade levels.
              </li>

              <li>
                <strong class="font-semibold text-blue-950">
                  Mastery learning,
                </strong>
                in which students receive iterative feedback and multiple
                opportunities to demonstrate competency before progressing.
              </li>
            </ul>
          </div>
          
        </div>
      </div>
    </div>
  </section>
</BaseLayout>