---
const stats = [
  {
    category: "Students",
    count: "200,000+",
  },
  {
    category: "Institutions",
    count: "5",
  },
  {
    category: "Courses",
    count: "800+",
  },
  {
    category: "Educators",
    count: "200+",
  },
];

const values = [
  {
    title: "Excellence",
    description:
      "We are committed to the relentless pursuit of excellence. We work hard, persevere through challenges, and never settle for less than our best. With grit and determination, we strive to overcome obstacles, achieve ambitious goals, and create transformative change.",
  },
  {
    title: "Unity",
    description:
      "We believe in the power of unity. We are at our best when we work as a team, appreciating the individuality of our colleagues and encouraging everyone to contribute their strengths. Together, we achieve our shared goals while helping each other grow.",
  },
  {
    title: "Integrity",
    description:
      "We hold integrity and transparency at the heart of everything we do. We uphold the highest ethical standards, building trust through honest communication and accountability. Our commitment to integrity ensures that our actions align with our vision for a better future in education.",
  },
  {
    title: "Innovation",
    description:
      "We embrace innovation as the key to transforming education. By creating dynamic, learner-centered systems, we empower both educators and learners, equipping them with the tools to support growth and inspire individual potential.",
  },
];
---

<section aria-labelledby="about-heading">
  <div
    class="relative mx-auto max-w-7xl px-8 py-16 md:px-12 lg:px-32 lg:py-24"
  >
    <div class="text-center">
      <h1
        id="about-heading"
        class="mx-auto max-w-4xl text-balance text-5xl font-semibold tracking-tight text-blue-950 font-display sm:text-6xl"
      >
        The mission behind Learning Innovators.
      </h1>

      <div class="mx-auto mt-6 max-w-3xl space-y-4">
        <p class="text-base leading-7 text-slate-600">
          Our mission is to transform learning by empowering educators with assessment models that drive personalised learning, supported by bespoke software tools designed to enhance student outcomes and improve education efficiency.
        </p>

        <p class="text-base leading-7 text-slate-600">
          Learning Innovators aspires to create a world where education is learner-centered and supported by assessment that and fosters agency, curiosity, and meaningful growth.
        </p>
      </div>
    </div>

    <dl class="mt-12 grid grid-cols-2 gap-3 text-center md:grid-cols-4 lg:mt-16">
      {
        stats.map((stat) => (
          <div class="flex w-full flex-col rounded-3xl bg-blue-100 p-5 lg:p-8">
            <dd class="text-2xl font-semibold tracking-tight text-blue-950 font-display sm:text-3xl">
              {stat.count}
            </dd>
            <dt class="mt-2 text-sm leading-6 text-slate-700 sm:text-base">
              {stat.category}
            </dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<section
  aria-labelledby="values-heading"
  class="border-y border-slate-200 bg-slate-50/70"
>
  <div class="mx-auto max-w-7xl px-8 py-16 md:px-12 lg:px-32 lg:py-24">
    <div class="max-w-3xl">
      <h2
        id="values-heading"
        class="text-4xl font-semibold tracking-tight text-blue-950 font-display"
      >
        A little bit about us...
      </h2>

      <p class="mt-5 text-base leading-7 text-slate-600">
        Learning Innovators exists to support like-minded and progressive educators to empower their students through the adoption of student-centred, assessment-driven learning.
      </p>

      <p class="mt-5 text-base leading-7 text-slate-600">
        We embrace the following values in all that we do:
      </p>
    </div>

    <ul class="mt-12 grid list-none gap-6 md:grid-cols-2" role="list">
      {
        values.map((value) => (
          <li class="h-full rounded-3xl border border-slate-200 bg-white p-7 shadow-sm md:p-8">
            <div
              class="mb-6 h-1 w-12 rounded-full bg-green-500"
              aria-hidden="true"
            ></div>
            <h3 class="text-xl font-semibold text-blue-950 font-display">
              {value.title}
            </h3>
            <p class="mt-3 leading-7 text-slate-600">{value.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>