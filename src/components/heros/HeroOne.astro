---
const stats = [
  {
    category: "Students",
    count: "200,000+",
  },
  {
    category: "Courses",
    count: "800+",
  },
  {
    category: "Educators",
    count: "200+",
  },
  {
    category: "Countries",
    count: "4",
  },
];
---

<section aria-labelledby="hero-heading">
  <div
    class="relative mx-auto max-w-7xl px-8 pb-12 pt-12 md:px-12 lg:px-32 lg:pb-16 lg:pt-24"
  >
    <div class="max-w-4xl lg:mt-12">
      <h1
        id="hero-heading"
        class="mt-4 text-5xl font-semibold tracking-tight text-blue-950 font-display sm:text-6xl lg:text-7xl"
      >
        Education re-imagined
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
        Learning Innovators was founded by a group of passionate educators dedicated to sharing the power of learner-centered assessment.
      </p>

      <p class="mt-4 max-w-3xl leading-7 text-slate-600">
        We drive innovative approaches to education, and support like-minded educators to empower their students through the adoption of student-centred approaches to learning.
      </p>
    </div>

    <dl
      class="mt-12 grid grid-cols-2 gap-3 text-center md:grid-cols-4 lg:mt-16"
      aria-label="Learning Innovators impact"
    >
      {
        stats.map((stat) => (
          <div class="flex w-full flex-col rounded-3xl bg-blue-100 p-5 lg:p-8">
            <dd class="text-2xl font-semibold tracking-tight text-blue-950 font-display sm:text-3xl">
              {stat.count}
            </dd>
            <dt class="mt-2 text-sm leading-6 text-slate-700 sm:text-base">
              {stat.category}
            </dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>